rule plot_figures_5b_5c:
    input:
        adata="results/preprocessing/adata.h5ad"
    output:
        heatmap_csv="results/paper/source_data/Fig5B_heatmap.tsv",
        heatmap_png="plots/paper/Fig5B_heatmap.png",
        heatmap_pdf="plots/paper/Fig5B_heatmap.pdf",
        umap_csv="results/paper/source_data/Fig5C_umap.tsv",
        groups_png="plots/paper/Fig5C_umap_groups.png",
        groups_pdf="plots/paper/Fig5C_umap_groups.pdf",
        markers_png="plots/paper/Fig5C_umap_markers.png",
        markers_pdf="plots/paper/Fig5C_umap_markers.pdf"
    params:
        podocyte_markers=config["figures"]["podocyte_markers"],
        umap_markers=config["figures"]["umap_markers"]
    conda:
        "../envs/pyenv.yaml"
    script:
        "../scripts/figures/plot_fig5bc.py"


rule plot_figures_5e_5f:
    input:
        csv="results/enrichment/ulm.tsv"
    output:
        collectri_csv="results/paper/source_data/Fig5E_collectri.tsv",
        collectri_png="plots/paper/Fig5E_collectri.png",
        collectri_pdf="plots/paper/Fig5E_collectri.pdf",
        progeny_csv="results/paper/source_data/Fig5F_progeny.tsv",
        progeny_png="plots/paper/Fig5F_progeny.png",
        progeny_pdf="plots/paper/Fig5F_progeny.pdf"
    params:
        top_n=config["figures"]["overview_top"]
    conda:
        "../envs/pyenv.yaml"
    script:
        "../scripts/figures/plot_enrichment.py"


rule plot_figure_5g:
    input:
        adata="results/preprocessing/adata.h5ad",
        degs="results/dea/interaction_calibrated.tsv",
        collectri=ancient(COLLECTRI_SNAPSHOT),
        progeny=ancient(PROGENY_SNAPSHOT)
    output:
        IRF1_csv="results/paper/source_data/Fig5G_IRF1.tsv",
        IRF1_png="plots/paper/Fig5G_IRF1.png",
        IRF1_pdf="plots/paper/Fig5G_IRF1.pdf",
        NFKB1_csv="results/paper/source_data/Fig5G_NFKB1.tsv",
        NFKB1_png="plots/paper/Fig5G_NFKB1.png",
        NFKB1_pdf="plots/paper/Fig5G_NFKB1.pdf",
        Hypoxia_csv="results/paper/source_data/Fig5G_Hypoxia.tsv",
        Hypoxia_png="plots/paper/Fig5G_Hypoxia.png",
        Hypoxia_pdf="plots/paper/Fig5G_Hypoxia.pdf",
        NFkB_csv="results/paper/source_data/Fig5G_NFkB.tsv",
        NFkB_png="plots/paper/Fig5G_NFkB.png",
        NFkB_pdf="plots/paper/Fig5G_NFkB.pdf",
        TNFa_csv="results/paper/source_data/Fig5G_TNFa.tsv",
        TNFa_png="plots/paper/Fig5G_TNFa.png",
        TNFa_pdf="plots/paper/Fig5G_TNFa.pdf",
        JAK_STAT_csv="results/paper/source_data/Fig5G_JAK_STAT.tsv",
        JAK_STAT_png="plots/paper/Fig5G_JAK_STAT.png",
        JAK_STAT_pdf="plots/paper/Fig5G_JAK_STAT.pdf",
        selected_genes_csv="results/paper/source_data/Fig5G_selected_genes.tsv",
        selected_genes_png="plots/paper/Fig5G_selected_genes.png",
        selected_genes_pdf="plots/paper/Fig5G_selected_genes.pdf"
    params:
        collectri_panels=config["figures"]["collectri_panels"],
        progeny_panels=config["figures"]["progeny_panels"],
        selected_genes=config["figures"]["selected_genes"],
        top_targets=config["figures"]["top_targets"],
        seed=config["random_seed"],
        collectri_sha256=config["prior_knowledge"]["collectri"]["sha256"],
        progeny_sha256=config["prior_knowledge"]["progeny"]["sha256"]
    conda:
        "../envs/pyenv.yaml"
    script:
        "../scripts/figures/plot_fig5g.py"
