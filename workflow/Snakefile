# define some output
## B_pseudobulks
### makePCAs
output_B_makePCAs_objects=[] 
output_B_makePCAs_plots=[]
for run_name in config['opts_B_makeMudata'].items():
    for lvl_celltype in config['opts_B_makePCAs']:
        #### objects
        output_B_makePCAs_objects.append('output/scRNAseq/B_pseudobulks/objects/makePCAs/{run_name}_{lvl}/{view}/anova.tsv'.format(
            run_name=run_name[0],
            lvl=lvl_celltype[0],
            view=lvl_celltype[1]))
        #### plots
        output_B_makePCAs_plots.append('output/scRNAseq/B_pseudobulks/plots/makePCAs/{run_name}_{lvl}/{view}/flag.txt'.format(
            run_name=run_name[0],
            lvl=lvl_celltype[0],
            view=lvl_celltype[1]))
### DEA_linearMixed_py
output_B_DEAlinearMixedpy_objects=[] 
output_B_DEAlinearMixedpy_plots=[] 
for run_name in config['opts_B_makeMudata'].items():
    for lvl in ['lvl1', 'lvl2']:
        #### objects
        filename="output/scRNAseq/B_pseudobulks/objects/DEA_linearMixed_py/{mdata_object_name}/degs.tsv".format(
            mdata_object_name=run_name[0]+'_'+lvl)
        output_B_DEAlinearMixedpy_objects.append(filename)
        #### plots
        filename="output/scRNAseq/B_pseudobulks/plots/DEA_linearMixed_py/{mdata_object_name}/flag.txt".format(
            mdata_object_name=run_name[0]+'_'+lvl)
        output_B_DEAlinearMixedpy_plots.append(filename)
### DEA_linearMixedpy_funcomics
output_B_DEAlinearMixedpyFuncomics_objects=[] 
for run_name in config['opts_B_makeMudata'].items():
    for lvl_celltype in config['opts_B_makePCAs']:
        #### objects
        output_B_DEAlinearMixedpyFuncomics_objects.append('output/scRNAseq/B_pseudobulks/objects/DEA_linearMixedpy_funcomics/{run_name}_{lvl}/{view}/kegg_gsea.tsv'.format(
            run_name=run_name[0],
            lvl=lvl_celltype[0],
            view=lvl_celltype[1]))
### DEA_linearMixedpy_plotFuncomics
output_B_DEAlinearMixedpyPlotFuncomics_plots=[] 
for run_name in config['opts_B_makeMudata'].items():
    for lvl in ['lvl1', 'lvl2']:
        #### plots
        filename="output/scRNAseq/B_pseudobulks/plots/DEA_linearMixedpy_plotFuncomics/{run_name_lvl}/flag.txt".format(
            run_name_lvl=run_name[0]+'_'+lvl)
        output_B_DEAlinearMixedpyPlotFuncomics_plots.append(filename)


