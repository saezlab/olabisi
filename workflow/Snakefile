from snakemake.utils import min_version
min_version("6.0")
import os

configfile: "config/config.yaml"

PROJECT_WORKDIR = os.environ.get("OLABISI_WORKDIR", os.getcwd())
workdir: PROJECT_WORKDIR

# define some variables
batches=['pilot', 'run01sample01', 'run01sample02', 'run02sample01', 
